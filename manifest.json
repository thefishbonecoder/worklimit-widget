{
  "manifest_version": 3,
  "name": "WorkMeter - Usage Monitor for ChatGPT",
  "short_name": "WorkMeter",
  "version": "1.0.0",
  "description": "Unofficial, privacy-focused monitor for ChatGPT Work and Codex usage limits, reset times, warnings and session usage.",
  "permissions": ["alarms", "notifications", "storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background-bootstrap.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "WorkMeter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
